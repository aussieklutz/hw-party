# Copy to .env (git-ignored): docker compose reads it from this directory.
# Only the first two are required.

# the stream worker this host runs its rounds on
WORKER_URL=https://stream.example.com
# must match the worker's STREAM_HOST_SECRET (wrangler secret / .dev.vars)
STREAM_HOST_SECRET=

# GPU adapter for docker-compose.wsl-gpu.yml (WSL2): NVIDIA | Intel
#GPU_ADAPTER=NVIDIA

# game: classic | fixed | dynamic | teams | imposter
#ROOM_MODE=dynamic
#ROOM_SLOTS=4
#POP_COUNT=2
#CPU_TIER=5

# Windows host (windows\run.ps1) encodes on the GPU; these are its defaults
#ENCODER=qsv            # qsv | nvenc | x264
#VIDEO_KBPS=6000        # constant bitrate
#STREAM_FPS=60

# OBS mode push target (default: the local mediamtx)
#FEED_URL=rtmp://127.0.0.1:1935/live/game

# --- Twitch direct, no OBS (FEED_MODE=composite) ----------------------------------------
# One ffmpeg for the whole session: the game and the slate are composed and
# encoded once (Quick Sync) and pushed straight to Twitch. The stream never drops between games.
# Needs STREAM_TAP (on by default in windowsun.ps1). The key is your Twitch dashboard's
# "Primary Stream key" (Settings > Stream); keep it in .env only, never in git or a zip.
#FEED_MODE=composite
#TWITCH_KEY=
#TWITCH_TEST=1   # first try: Twitch's bandwidth test, the stream never goes live; remove the line to go live
#TWITCH_INGEST=aps20.contribute.live-video.net   # Sydney; any ingest from https://ingest.twitch.tv/ingests
# Game frames go out exactly as the engine drew them; whenever there are none (between games, a game
# loading) the slate shows: <WORKER_URL>/stream/, the slide show. Both can be changed; a page over the game
# is off by default (for example <WORKER_URL>/stream/scoreboard.html)
#OVERLAY_GAME_URL=
#OVERLAY_SLATE_URL=
#OVERLAY=0                  # no overlay at all
#STREAM_MUSIC=1             # the game's background music on the stream (default off: it makes the audio choppy)
#STREAM_ZOOM=150            # the game's zoom in percent (50-175; the engine's own default is 100). The camera
                            # keeps the active hog in the middle of the frame
# Close-up of the active hog on the active player's phone (not on Twitch): the agent cuts a small window
# out of the engine's frame, centred on the hog (or on its target when a cursor is in use), and sends it
# as JPEG, about 15 a second, to that player only. The phone has a Close-up on/off button.
#HOG_VIEW=0                 # turn it off
#HOG_VIEW_FPS=15
#HOG_VIEW_W=320             # window size in pixels of a 1080 line frame (scaled with the frame)
#HOG_VIEW_H=216
#SLATE_COLOR=0d0b1e         # background of the slate (RRGGBB)
#OVERLAY_BROWSER=           # chrome.exe or msedge.exe (default: found automatically)
#FEED_PRIORITY=high         # high | normal: process priority of the agent and its ffmpeg
#STREAM_WIDTH=1280
#STREAM_HEIGHT=720
#STREAM_FPS=30

# timings in milliseconds
#LOBBY_WAIT_MS=180000
#ROUND_WAIT_MS=30000
#SLATE_MS=15000
