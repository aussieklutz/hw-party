# Copy to .env (git-ignored): docker compose reads it from this directory.
# Only the first two are required.

# the stream worker this host runs its rounds on
WORKER_URL=https://stream.example.com
# must match the worker's STREAM_HOST_SECRET (wrangler secret / .dev.vars)
STREAM_HOST_SECRET=

# game: classic | fixed | dynamic | teams | imposter
#ROOM_MODE=dynamic
#ROOM_SLOTS=4
#POP_COUNT=2
#CPU_TIER=5

# OBS mode push target (default: the local mediamtx)
#FEED_URL=rtmp://127.0.0.1:1935/live/game
#STREAM_WIDTH=1920
#STREAM_HEIGHT=1080
#STREAM_FPS=30

# timings in milliseconds
#LOBBY_WAIT_MS=180000
#ROUND_WAIT_MS=30000
#SLATE_MS=15000
